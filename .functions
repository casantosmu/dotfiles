# Change the date of the latest commit without changing its contents or message
# Usage: git_redate "2026-10-14 18:30"
git_redate() {
    local git_date
    git_date=$(date -d "$1" -R)
    GIT_COMMITTER_DATE="$git_date" git commit --amend --date="$git_date" --no-edit
}

# Update apt package lists and upgrade installed packages
upgrate() {
    sudo apt update && sudo apt upgrade -y
}

# Stop and remove all Docker containers
docker_clean() {
    docker stop $(docker ps -q)
    docker rm $(docker ps -a -q)
}

# Clear the terminal
c() {
    clear
}

# Show directory sizes, including hidden entries, largest first
dus() {
    du -hs -- *(D) | sort -hr
}

# Back up selected home files
# Usage: backup_home [--dry-run] DESTINATION
backup_home() {
    local options=(
        -avh
        --progress
        --ignore-missing-args
        --exclude='node_modules/'
        --exclude='Cache/'
        --exclude='coverage/'
        --exclude='dist/'
        --exclude='build/'
        --exclude='.gradle/'
        --exclude='.idea/'
        --exclude='.dart_tool/'
        --exclude='chrome-profile/'
    )
    local sources=(
        "$HOME/Descargas"
        "$HOME/development"
        "$HOME/Documentos"
        "$HOME/Documents"
        "$HOME/Downloads"
        "$HOME/indigitall"
        "$HOME/.dotfiles"
        "$HOME/Escritorio"
        "$HOME/.gitconfig.local"
        "$HOME/Imágenes"
        "$HOME/Vídeos"
        "$HOME/Música"
    )
    if [[ "$1" == "--dry-run" ]]; then
        options+=(--dry-run --exclude='.git/')
        shift
    fi
    rsync "${options[@]}" "${sources[@]}" "$1"
}
