git_redate() {
    local git_date
    git_date=$(date -d "$1" -R)
    GIT_COMMITTER_DATE="$git_date" git commit --amend --date="$git_date" --no-edit
}

upgrate() {
    sudo apt update && sudo apt upgrade -y
}

docker_clean() {
    docker stop $(docker ps -q)
    docker rm $(docker ps -a -q)
}

c() {
    clear
}

dus() {
    du -hs -- *(D) | sort -hr
}

backup_home() {
    local options=(-avh --progress --exclude='node_modules/')
    [[ "$1" == "--dry-run" ]] && options+=(--dry-run) && shift
    rsync "${options[@]}" "$HOME"/{Descargas,development,Documentos,.dotfiles,Escritorio,.gitconfig.local,Imágenes} "$1"
}
